# Parametres de connexion a la base de donnees MySQL
# (chaque valeur peut etre surchargee au lancement : -Dgestimed.db.password=...)

url=jdbc:mysql://localhost:3306/
dbName = medicale
# Options du pilote MySQL Connector/J 8 (ajoutees apres le nom de la base)
parametres = useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
driver = com.mysql.cj.jdbc.Driver
userName = root
# Ne jamais mettre le mot de passe ici (ce fichier est dans git et dans le jar).
# Le fournir dans un fichier local gestimed.properties (repertoire courant,
# repertoire utilisateur, ou chemin donne par -Dgestimed.config=...) :
#     password = ...
# ou au lancement : -Dgestimed.db.password=...
password =
