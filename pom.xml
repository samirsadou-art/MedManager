<?xml version="1.0" encoding="UTF-8"?>
<!--
  GestiMed : gestion d'un cabinet médical (Java Swing, MySQL).
  Projet Maven : remplace le projet NetBeans/Ant et ses .jar référencés en dur
  (D:\JAVA developpement tools\...). Les dépendances sont téléchargées depuis
  Maven Central.

  Commandes utiles :
    mvn test            compile et exécute les tests
    mvn package         produit target/gestimed-3.5-jar-with-dependencies.jar (exécutable)
    mvn exec:java       lance l'application
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dz.cabinet</groupId>
    <artifactId>gestimed</artifactId>
    <version>3.5</version>
    <packaging>jar</packaging>

    <name>GestiMed</name>
    <description>Gestion d'un cabinet médical (Swing, architecture DAO + MVC)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Java 8 comme le projet d'origine ; compilable avec tout JDK récent (11, 17, 21). -->
        <maven.compiler.release>8</maven.compiler.release>
        <!-- Classe principale : utilisée par NetBeans (Exécuter) et par exec:java. -->
        <exec.mainClass>My_application.PrincipalForm</exec.mainClass>

        <openpdf.version>1.3.43</openpdf.version>
        <pdfbox.version>3.0.5</pdfbox.version>
        <mysql.version>8.4.0</mysql.version>
        <junit.version>4.13.2</junit.version>
        <flatlaf.version>3.7.2</flatlaf.version>
        <!-- Flyway 9 : dernière version compatible Java 8 (MySQL et MariaDB via flyway-mysql). -->
        <flyway.version>9.22.3</flyway.version>
        <jacoco.version>0.8.14</jacoco.version>
        <spotbugs.plugin.version>4.9.8.5</spotbugs.plugin.version>
        <!-- Seuil de couverture des lignes par paquet (service, dao.jdbc, controller), sans le test MySQL. -->
        <couverture.minimum>0.60</couverture.minimum>
        <spotbugs.seuil>Medium</spotbugs.seuil>
    </properties>

    <dependencies>
        <!-- Génération des ordonnances et demandes d'analyses en PDF (remplace JasperReports). -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- Aperçu des PDF dans l'application (rendu des pages) et impression sans visionneuse externe. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- Pilote MySQL (remplace mysql-connector-java-5.0.8-bin.jar de 2007). -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Migrations versionnées du schéma (src/main/resources/db/migration, outils/MigrationBase). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- Thème graphique moderne (remplace Nimbus) et icônes SVG (vue/Theme, vue/Icones). -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-extras</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- argLine est fourni par jacoco:prepare-agent (vide sans JaCoCo). -->
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.awt.headless>true</java.awt.headless>
                        <!-- Coupe le journal « GestiMed » : les pannes simulées par les tests ne polluent plus la console. -->
                        <java.util.logging.config.file>${project.basedir}/src/test/resources/journal-tests.properties</java.util.logging.config.file>
                        <!-- Tests d'intégration MySQL (base dédiée *_test) : décommenter ou passer en -D.
                        <gestimed.test.db.url>jdbc:mysql://localhost:3306/medicale_test</gestimed.test.db.url>
                        <gestimed.test.db.user>root</gestimed.test.db.user>
                        <gestimed.test.db.password></gestimed.test.db.password>
                        -->
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Couverture des tests : target/site/jacoco/index.html après mvn verify.
                 Seuils minimaux sur les couches testées (services, DAO, contrôleurs) :
                 ils ne doivent que monter. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>rapport</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>seuils</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>My_application.service</include>
                                        <include>My_application.dao.jdbc</include>
                                        <include>My_application.controller</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${couverture.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Analyse statique : mvn verify échoue sur un bogue probable.
                 Rapport : target/spotbugsXml.xml, ou mvn spotbugs:gui. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>${spotbugs.seuil}</threshold>
                    <excludeFilterFile>spotbugs-exclusions.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>analyse</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Jar exécutable unique (double-clic) incluant OpenPDF et le pilote MySQL. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/jar-executable.xml</descriptor>
                    </descriptors>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                        <manifestEntries>
                            <!-- JDK 24+ : autorise FlatLaf à charger sa bibliothèque native
                                 (fenêtres Windows) sans avertissement au démarrage. -->
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>jar-executable</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
